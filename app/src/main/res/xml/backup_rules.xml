<?xml version="1.0" encoding="utf-8"?>
<!--
   Respaldo automatico hasta Android 11. Desde Android 12 manda
   data_extraction_rules.xml, que excluye lo mismo.

   La sesion de Supabase Auth no se respalda (S2-T08, DEC-30): va cifrada con
   una llave del Android Keystore que no viaja con el respaldo, asi que en otro
   telefono no se puede descifrar. Las SharedPreferences por omision se excluyen
   porque ahi la dejaba en texto plano SettingsSessionManager antes de S2-T08.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/sesion_cifrada.preferences_pb" />
    <exclude domain="sharedpref" path="mx.donchambitas.app_preferences.xml" />
</full-backup-content>
