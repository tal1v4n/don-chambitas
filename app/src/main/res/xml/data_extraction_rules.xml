<?xml version="1.0" encoding="utf-8"?>
<!--
   Respaldo en la nube y transferencia entre dispositivos, desde Android 12.
   Mismas exclusiones que backup_rules.xml, por la misma razon: la sesion va
   cifrada con una llave del Keystore que se queda en este telefono (S2-T08).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/sesion_cifrada.preferences_pb" />
        <exclude domain="sharedpref" path="mx.donchambitas.app_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sesion_cifrada.preferences_pb" />
        <exclude domain="sharedpref" path="mx.donchambitas.app_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
